# Copy to .env (PowerShell: Copy-Item .env.example .env) and fill in real values.
# Never commit .env.

# Comma-separated key pool, at least 2 keys. Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key
# Exact LiteLLM model string, e.g. gemini/<model-id copied from AI Studio>
LLM_MODEL=gemini/your-model-id
# Optional: one model per key (same order as LLM_API_KEYS). Leave empty to use LLM_MODEL for all.
LLM_MODELS=
LLM_TIMEOUT_SECONDS=30
# Optional constants sent on every call (part of the cache key). Leave empty to omit.
LLM_TEMPERATURE=
LLM_REASONING_EFFORT=
LLM_CACHE_DIR=/data/litellm-cache
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
# Frontend build-time backend URL (browser origin, not the Docker hostname)
VITE_API_BASE_URL=http://localhost:8000
